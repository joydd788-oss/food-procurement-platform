BUYER_PASSWORD=please-change-buyer-password
SUPPLIER_USERNAME=supplier
SUPPLIER_PASSWORD=please-change-supplier-password

# 数据库与缓存（生产环境请改为强密码）
POSTGRES_DB=procurement
POSTGRES_USER=procurement
